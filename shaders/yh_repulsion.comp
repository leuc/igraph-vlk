// =============================================================================
// YHRT Repulsion Compute Shader — GPU-Accelerated All-Pairs Repulsive Forces
// =============================================================================
//
// Implements the repulsive force component of the Yu Hu (YHu) force-directed
// graph layout algorithm using Vulkan ray queries for spatial acceleration.
//
// Algorithm overview:
//   Each node i emits a ray query against the TLAS (top-level acceleration
//   structure). The TLAS encloses AABB bounding volumes centered on every node
//   with radius R = 5*K (where K is the average edge length). The ray query
//   traverses all AABBs that overlap the ray, and for each nearby node j
//   (j != i), a power-law repulsive force is accumulated:
//
//     F_repel(i) = KP * (pos_i - pos_j) / dist(pos_i, pos_j)^(p+1)
//
//   where:
//     KP   = K^(1-p)   — precomputed push constant (see rt_layout.c:389)
//     p    = repulsion exponent (default 1.0, matching igraph's FR model)
//     K    = average edge length from initial positions
//     dist = Euclidean distance between nodes i and j
//
// Dispatched once per iteration, once per node (vertex_count workgroups of 256).
// The output forces[] buffer is later combined with attraction forces in
// yh_attraction.comp and applied in yh_update.comp.
//
// Binding layout (shared across all YHRT shaders):
//   binding 0: NodeBuffer   — vec4[pos.xyz, degree] per node (readonly here)
//   binding 1: ForceBuffer  — vec4[force.xyz, 0] per node (writeonly here)
//   binding 3: TLAS         — top-level acceleration structure for ray queries
//
// Push constants (28 bytes, matching rt_layout.c push constant struct):
//   KP          — K^(1-p), repulsion scaling factor
//   CRK         — C^((2-p)/3) / K, attraction scaling factor (unused here)
//   p           — repulsion power-law exponent
//   step_size   — adaptive step size / cooling schedule (unused here)
//   vertex_count — number of nodes in the graph
//   edge_count   — number of edges (unused here)
//   R           — BVH search radius = 5*K
// =============================================================================

#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct NodeData {
	vec4 pos; // xyz = position, w = degree (unused in repulsion)
};

layout(std430, binding = 0) readonly buffer NodeBuffer {
	NodeData nodes[];
};

layout(std430, binding = 1) buffer ForceBuffer {
	vec4 forces[]; // Accumulated repulsive force per node (xyz)
};

layout(binding = 3) uniform accelerationStructureEXT tlas;

layout(push_constant) uniform PC {
	float KP;          // K^(1-p): repulsion magnitude scaling
	float CRK;         // C^((2-p)/3) / K: attraction scaling (not used here)
	float p;           // repulsion power-law exponent (e.g. 1.0 for FR)
	float step_size;   // adaptive step size for position update (not used here)
	uint vertex_count; // total number of graph nodes
	uint edge_count;   // total number of graph edges (not used here)
	float R;           // BVH AABB half-extent = 5*K
}
pc;

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= pc.vertex_count)
		return;

	vec3 pos = nodes[i].pos.xyz;
	vec3 force = vec3(0.0);

	// Initialize ray query against the TLAS. The ray origin is node i's
	// position; direction is arbitrary (1,0,0) since we only care about AABB
	// intersection tests, not geometry hits. Tmax is set to R so we only
	// consider nodes within the BVH search radius.
	rayQueryEXT rq;
	rayQueryInitializeEXT(rq, tlas, gl_RayFlagsNoneEXT, 0xFF, pos, 0.0, vec3(1.0, 0.0, 0.0), 0.0001);

	// Traverse all AABB candidates in the BVH. Each candidate corresponds to
	// one node instance in the TLAS.
	while (rayQueryProceedEXT(rq)) {
		if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionAABBEXT) {
			uint j = rayQueryGetIntersectionInstanceIdEXT(rq, false);
			if (i != j) {
				vec3 npos = nodes[j].pos.xyz;
				vec3 diff = pos - npos;
				float d2 = dot(diff, diff);

				// Degenerate case: nodes at identical positions. Apply a tiny
				// asymmetric epsilon to break symmetry and produce a nonzero
				// force direction. The sign depends on global index ordering
				// to ensure the two nodes push apart consistently.
				if (d2 < 1e-12) {
					float eps = (i > j) ? 1e-5 : -1e-5;
					diff += vec3(eps);
					d2 = dot(diff, diff);
				}

				float dist = sqrt(d2);

				// Power-law repulsion: scale = KP / dist^(p+1).
				// For p=1 (FR), this simplifies to KP / dist^2.
				// The force vector is along the diff direction (repulsive).
				float scale = pc.KP / pow(dist, pc.p + 1.0);

				// Guard against infinity/NaN from very small distances
				if (isinf(scale) || isnan(scale))
					scale = 1e10;

				force += scale * diff;
			}
		}
	}

	forces[i].xyz = force;
}
