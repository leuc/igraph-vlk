#version 460
#extension GL_EXT_ray_tracing : require

layout(location = 0) rayPayloadEXT float hitDistance;

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;

struct NodePhysics {
	vec4 position;
	vec4 velocity;
	vec4 escape_vector;
};

layout(std430, binding = 1, set = 0) buffer PhysicsBuffer {
	NodePhysics nodes[];
};

layout(push_constant) uniform PushConstants {
	uint frame_index;
	float ray_max_distance;
} pc;

float hash(uint n) {
	n = (n << 13U) ^ n;
	return float(n * (n * n * 15731U + 789221U) + 1376312589U) / 4294967296.0;
}

vec3 get_random_direction(uint seed, uint ray_idx) {
	uint s = seed * 1973U + pc.frame_index * 9277U + ray_idx * 26699U;
	float theta = hash(s) * 2.0 * 3.14159265;
	float phi = acos(2.0 * hash(s + 1U) - 1.0);
	return vec3(sin(phi) * cos(theta), sin(phi) * sin(theta), cos(phi));
}

void main() {
	uint nodeId = gl_LaunchIDEXT.x;
	if (nodeId >= gl_LaunchSizeEXT.x) return;

	vec3 origin = nodes[nodeId].position.xyz;
	vec3 finalEscape = vec3(0.0);
	const int RAY_COUNT = 16;

	for (int i = 0; i < RAY_COUNT; i++) {
		vec3 dir = get_random_direction(nodeId, uint(i));
		hitDistance = 0.0;

		traceRayEXT(topLevelAS,
			gl_RayFlagsOpaqueEXT,
			0xFF, 0, 0, 0,
			origin, 0.01, dir, pc.ray_max_distance, 0);

		float weight = 1.0 / max(hitDistance * hitDistance, 0.01);
		finalEscape -= dir * weight;
	}

	// Normalize to unit length: direction only, magnitude controlled by alpha on CPU.
	// This prevents 1/d² divergence from overwhelming spring forces at close range.
	float len = length(finalEscape);
	nodes[nodeId].escape_vector.xyz = (len > 0.0001) ? finalEscape / len : vec3(0.0);
}
