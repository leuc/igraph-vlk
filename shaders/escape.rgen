#version 460
#extension GL_EXT_ray_tracing : require

struct RayPayload {
	float hitDistance;
	uint originNodeId;
};
layout(location = 0) rayPayloadEXT RayPayload payload;

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;

struct NodePhysics {
	vec4 position;      // xyz=pos, w=nodeRadius
	vec4 escape_vector; // xyz=escape_dir, w=openness
	vec4 freedom;       // x=local_freedom [0..1], w=is_awake (1.0 awake, 0.0 asleep)
};

layout(std430, binding = 1, set = 0) buffer PhysicsBuffer {
	NodePhysics nodes[];
};

layout(push_constant) uniform PushConstants {
	uint frame_index;
	float ray_max_distance;
} pc;

#define RAY_COUNT 16

// Fibonacci sphere: evenly distributes RAY_COUNT points around the sphere
// Node-specific offset (deterministic, no frame_index) keeps distinct patterns per node
vec3 fibonacci_sphere_dir(uint node_id, uint ray_idx) {
	const float GOLDEN_ANGLE = 2.399963229728653;
	float y = 1.0 - (2.0 * float(ray_idx) + 1.0) / float(RAY_COUNT);
	float r = sqrt(1.0 - y * y);
	float theta = GOLDEN_ANGLE * float(ray_idx) + GOLDEN_ANGLE * float(node_id) * 0.137;
	return vec3(cos(theta) * r, sin(theta) * r, y);
}

void main() {
	uint nodeId = gl_LaunchIDEXT.x;
	if (nodeId >= gl_LaunchSizeEXT.x) return;

	vec3 origin = nodes[nodeId].position.xyz;

	// Awake nodes get full 16-ray pathfinding.
	// Asleep nodes get a low-cost 4-ray tripwire to watch for intruders.
	bool is_awake = (nodes[nodeId].freedom.w > 0.5);
	int active_ray_count = is_awake ? RAY_COUNT : 4;

	vec3 finalEscape = vec3(0.0);
	float miss_count = 0.0;
	float total_hit_distance = 0.0;

	for (int i = 0; i < active_ray_count; i++) {
		vec3 dir = fibonacci_sphere_dir(nodeId, uint(i));
		payload.hitDistance = 0.0;
		payload.originNodeId = nodeId;

		// The any-hit shader handles self-intersection and neighbor transparency,
		// so no need to offset ray origin.
		vec3 rayOrigin = origin;

		traceRayEXT(topLevelAS,
			gl_RayFlagsNoOpaqueEXT,
			0xFF, 0, 0, 0,
			rayOrigin, 0.01, dir, pc.ray_max_distance, 0);

		total_hit_distance += payload.hitDistance;

		if (payload.hitDistance >= pc.ray_max_distance * 0.99) {
			// Miss: open space in this direction — pull toward it (expansion)
			finalEscape += dir;
			miss_count += 1.0;
		} else {
			// Hit: geometry nearby — push away (repulsion)
			// Clamp weight so close hits don't dominate the signal
			float weight = min(1.0 / max(payload.hitDistance * payload.hitDistance, 0.01), 4.0);
			finalEscape -= dir * weight;
		}
	}

	// Continuous Local Freedom [0.0 to 1.0]: fraction of ray_max_distance
	// the average ray traveled before hitting geometry.
	float mean_free_path = total_hit_distance / float(active_ray_count);
	float local_freedom = mean_free_path / pc.ray_max_distance;
	// Clamp to [0, 1] in case of numerical issues
	nodes[nodeId].freedom.x = clamp(local_freedom, 0.0, 1.0);

	// Magnitude = openness (fraction of rays that missed).
	// This encodes HOW MUCH open space surrounds the node:
	//   fully enclosed -> ~0 (no escape force, only springs act)
	//   fully open     -> ~1 (strong escape force outward)
	// Direction = weighted sum of open directions minus obstacles.
	float openness = miss_count / float(active_ray_count);

	// In totally open space, we are already free — no escape pull needed.
	if (miss_count == float(active_ray_count)) {
		nodes[nodeId].escape_vector.xyz = vec3(0.0);
	} else {
		float len = length(finalEscape);
		// Increase threshold to ignore minor asymmetric noise
		nodes[nodeId].escape_vector.xyz = (len > 0.1) ? (finalEscape / len) * openness : vec3(0.0);
	}
}
