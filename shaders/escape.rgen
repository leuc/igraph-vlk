#version 460
#extension GL_EXT_ray_tracing : require

struct RayPayload {
	uint originNodeId;
	uint escaped;
	uint isCohesionRay;
};
layout(location = 0) rayPayloadEXT RayPayload payload;

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;

struct NodePhysics {
	vec4 position;      // xyz=pos, w=nodeRadius
	vec4 escape_vector; // xyz=escape_dir, w=openness
	vec4 freedom;       // x=local_freedom [0..1], w=is_awake (1.0 awake, 0.0 asleep)
};

layout(std430, binding = 1, set = 0) buffer PhysicsBuffer {
	NodePhysics nodes[];
};

layout(std430, binding = 2, set = 0) readonly buffer AdjacencyList { uint neighbors[]; };
layout(std430, binding = 3, set = 0) readonly buffer AdjOffsets  { uint offsets[]; };
layout(std430, binding = 4, set = 0) readonly buffer AdjCounts   { uint edge_counts[]; };

layout(push_constant) uniform PushConstants {
	uint frame_index;
	float ray_max_distance;
} pc;

#define RAY_COUNT 16

vec3 fibonacci_sphere_dir(uint node_id, uint ray_idx) {
	const float GOLDEN_ANGLE = 2.399963229728653;
	float y = 1.0 - (2.0 * float(ray_idx) + 1.0) / float(RAY_COUNT);
	float r = sqrt(1.0 - y * y);
	float theta = GOLDEN_ANGLE * float(ray_idx) + GOLDEN_ANGLE * float(node_id) * 0.137;
	return vec3(cos(theta) * r, sin(theta) * r, y);
}

void main() {
	uint nodeId = gl_LaunchIDEXT.x;
	if (nodeId >= gl_LaunchSizeEXT.x) return;

	vec3 origin = nodes[nodeId].position.xyz;

	int active_ray_count = RAY_COUNT;

	uint escaped_count = 0;
	vec3 escape_sum = vec3(0.0);
	vec3 first_escaped_dir = vec3(0.0);

	for (int i = 0; i < active_ray_count; i++) {
		vec3 dir = fibonacci_sphere_dir(nodeId, uint(i));

		payload.originNodeId = nodeId;
		payload.escaped = 0;

		traceRayEXT(topLevelAS,
			gl_RayFlagsNoOpaqueEXT,
			0xFF, 0, 0, 0,
			origin, 0.01, dir, pc.ray_max_distance, 0);

		if (payload.escaped == 1) {
			if (escaped_count == 0) first_escaped_dir = dir;
			escape_sum += dir;
			escaped_count++;
		}
	}

	float freedom = float(escaped_count) / float(active_ray_count);
	nodes[nodeId].freedom.x = clamp(freedom, 0.0, 1.0);
	nodes[nodeId].freedom.z = float(escaped_count);

	vec3 final_escape = vec3(0.0);

	if (escaped_count > 0) {
		vec3 avg = escape_sum / float(escaped_count);
		vec3 escape_dir = (length(avg) > 0.01) ? normalize(avg) : first_escaped_dir;
		final_escape = escape_dir * freedom;

		// Cohesion: pull toward neighbor centroid if neighbors drifted
		uint deg = edge_counts[nodeId];
		nodes[nodeId].freedom.y = 0.0;
		if (deg > 0) {
			vec3 cent = vec3(0.0);
			uint start = offsets[nodeId];
			for (uint i = 0; i < deg; i++)
				cent += nodes[neighbors[start + i]].position.xyz;
			cent /= float(deg);
			vec3 cohesion_dir = cent - origin;
			float cohesion_len = length(cohesion_dir);
			if (cohesion_len > 0.001) {
				cohesion_dir /= cohesion_len;

				payload.originNodeId = nodeId;
				payload.escaped = 0;
				payload.isCohesionRay = 1;
				traceRayEXT(topLevelAS,
					gl_RayFlagsNoOpaqueEXT,
					0xFF, 0, 0, 0,
					origin, 0.01, cohesion_dir, pc.ray_max_distance, 0);

				if (payload.escaped == 1) {
					// Neighbors drifted — pull toward centroid
					float pull = 0.3 * (1.0 - freedom);
					final_escape += cohesion_dir * pull;
					nodes[nodeId].freedom.y = 2.0; // debug: cohesion ray escaped
				} else {
					nodes[nodeId].freedom.y = 1.0; // debug: cohesion ray hit a neighbor
				}
			}
		}
	}

	nodes[nodeId].escape_vector.xyz = final_escape;
}
