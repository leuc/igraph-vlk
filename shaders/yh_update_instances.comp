// =============================================================================
// YHRT Update Instances Compute Shader — Sync Node Positions to TLAS Transforms
// =============================================================================
//
// Updates the VkAccelerationStructureInstanceKHR transform matrices in the
// instance buffer so that the TLAS (top-level acceleration structure) reflects
// the current node positions. This is the final compute step of each YHRT
// iteration, executed AFTER yh_update.comp / yh_update_fp64.comp.
//
// After this dispatch, the host rebuilds the TLAS in update mode
// (rt_layout.c:722-738) so that the next repulsion pass (yh_repulsion.comp)
// queries AABBs at the correct updated positions.
//
// Each instance in the TLAS has a 3x4 affine transform matrix that positions
// the BLAS (a single AABB of radius R centered at the origin) at the node's
// current 3D position. The transform layout (column-major, matching Vulkan's
// VkTransformMatrixKHR):
//
//   Row 0: [1, 0, 0, pos.x]   — X axis + translation X
//   Row 1: [0, 1, 0, pos.y]   — Y axis + translation Y
//   Row 2: [0, 0, 1, pos.z]   — Z axis + translation Z
//
// Each node occupies 4 consecutive vec4s in the instance_data[] buffer
// (12 floats = 48 bytes = sizeof(VkAccelerationStructureInstanceKHR::transform)).
// The fourth row (implicit [0,0,0,1]) is not stored.
//
// Dispatched once per iteration, once per node (vertex_count workgroups of 256).
// Must be followed by a TLAS rebuild barrier before the next repulsion pass.
//
// Binding layout:
//   binding 0: NodeBuffer    — vec4[pos.xyz, degree] per node (readonly)
//   binding 5: InstanceBuffer — vec4[4] per node, TLAS instance transform (writeonly)
//
// Push constants (28 bytes):
//   KP, CRK, p, step_size, vertex_count, edge_count, R
// =============================================================================

#version 460

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct NodeData
{
	vec4 pos; // xyz = current position, w = degree
};

layout(std430, binding = 0) readonly buffer NodeBuffer
{
	NodeData nodes[];
};

// Packed instance transform data. Each node i occupies indices [i*4 .. i*4+3].
// These 4 vec4s form the 3x4 column-major transform matrix for the TLAS.
layout(std430, binding = 5) buffer InstanceBuffer
{
	vec4 instance_data[];
};

layout(push_constant) uniform PC
{
	float KP;		   // K^(1-p) (not used here)
	float CRK;		   // C^((2-p)/3) / K (not used here)
	float p;		   // repulsion exponent (not used here)
	float step_size;   // adaptive step size (not used here)
	uint vertex_count; // total number of nodes
	uint edge_count;   // total number of edges (not used here)
	float R;		   // BVH radius (not used here)
	uint num_levels;   // number of BLAS geometry levels (not used here)
}
pc;

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= pc.vertex_count)
		return;

	vec3 pos = nodes[i].pos.xyz;

	// Write 3x4 column-major transform matrix for VkAccelerationStructureInstanceKHR.
	// The BLAS is a unit AABB at the origin; this transform translates it to pos.
	instance_data[i * 4 + 0] = vec4(1.0, 0.0, 0.0, pos.x);
	instance_data[i * 4 + 1] = vec4(0.0, 1.0, 0.0, pos.y);
	instance_data[i * 4 + 2] = vec4(0.0, 0.0, 1.0, pos.z);
	// instance_data[i * 4 + 3] is unused (implicit row [0,0,0,1])
}
