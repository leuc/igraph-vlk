#version 460
#extension GL_EXT_ray_tracing : require

struct RayPayload {
	uint originNodeId;
	uint escaped; // 1 if miss fired (open space), 0 if hit committed (blocked)
	uint isCohesionRay; // 0 = escape ray, 1 = cohesion ray toward neighbor centroid
};
layout(location = 0) rayPayloadInEXT RayPayload payload;

layout(std430, binding = 2, set = 0) readonly buffer AdjacencyList { uint neighbors[]; };
layout(std430, binding = 3, set = 0) readonly buffer AdjOffsets  { uint offsets[]; };
layout(std430, binding = 4, set = 0) readonly buffer AdjCounts   { uint edge_counts[]; };

void main() {
	uint hitNodeId = gl_InstanceCustomIndexEXT;
	uint originId = payload.originNodeId;

	if (payload.isCohesionRay == 1) {
		// Cohesion ray: only commit if we hit a specific neighbor
		if (hitNodeId == originId) {
			ignoreIntersectionEXT; // skip self
			return;
		}
		// Check if hitNodeId is a neighbor
		uint start = offsets[originId];
		uint count = edge_counts[originId];
		for (uint i = 0; i < count; i++) {
			if (neighbors[start + i] == hitNodeId) {
				return; // hit a neighbor — commit, closest-hit fires, escaped=0
			}
		}
		// Non-neighbor: ignore (we only care about whether our specific neighbors are nearby)
		ignoreIntersectionEXT;
		return;
	}

	// Escape ray: ignore self and neighbors
	if (hitNodeId == originId) {
		ignoreIntersectionEXT;
		return;
	}
	uint start_idx = offsets[originId];
	uint count = edge_counts[originId];
	for (uint i = 0; i < count; i++) {
		if (neighbors[start_idx + i] == hitNodeId) {
			ignoreIntersectionEXT;
			return;
		}
	}

	// Non-neighbor object in the way — block the ray (commit the hit)
}
