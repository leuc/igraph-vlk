#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct NodePhysics {
	vec4 position;
	vec4 velocity;
	vec4 escape_vector;
};

layout(std430, binding = 0, set = 0) buffer PhysicsBuffer {
	NodePhysics nodes[];
};

layout(std430, binding = 1, set = 0) readonly buffer AdjacencyList {
	uint neighbors[];
};

layout(std430, binding = 2, set = 0) readonly buffer AdjOffsets {
	uint offsets[];
};

layout(std430, binding = 3, set = 0) readonly buffer AdjCounts {
	uint edge_counts[];
};

layout(push_constant) uniform SimParams {
	float dt;
	float alpha;
	float beta;
	float friction;
	float avg_degree;
	uint node_count;
} params;

void main() {
	uint id = gl_GlobalInvocationID.x;
	if (id >= params.node_count) return;

	vec3 pos = nodes[id].position.xyz;
	vec3 escape_force = nodes[id].escape_vector.xyz;
	vec3 spring_force = vec3(0.0);

	uint start_idx = offsets[id];
	uint count = edge_counts[id];

	for (uint i = 0; i < count; i++) {
		uint neighbor_id = neighbors[start_idx + i];
		vec3 neighbor_pos = nodes[neighbor_id].position.xyz;

		vec3 diff = neighbor_pos - pos;
		float dist = length(diff);

		if (dist > 0.001) {
			// Linear attraction proportional to distance (no ideal length)
			spring_force += diff;
		}
	}

	// Scale spring force by degree: high-degree nodes feel weaker attraction per edge
	// (outbound attraction distribution, similar to ForceAtlas2)
	if (count > 0) {
		float degree_weight = (1.0 + params.avg_degree) / (1.0 + float(count));
		spring_force *= degree_weight;
	}

	// Scale escape force by degree: high-degree nodes push outward more
	if (count > 0)
		escape_force *= float(count);

	vec3 total_force = (escape_force * params.alpha) + (spring_force * params.beta);

	vec3 vel = nodes[id].velocity.xyz;
	// Friction damps existing velocity, but new force impulse is full-strength
	vel = vel * params.friction + total_force * params.dt;

	nodes[id].velocity.xyz = vel;
	nodes[id].position.xyz = pos + (vel * params.dt);
}
