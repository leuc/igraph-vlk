#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct NodePhysics {
	vec4 position;      // xyz=pos, w=nodeRadius
	vec4 escape_vector; // xyz=escape_dir, w=openness
	vec4 freedom;       // x=local_freedom [0..1], w=is_awake (1.0 awake, 0.0 asleep)
};

layout(std430, binding = 0, set = 0) buffer PhysicsBuffer {
	NodePhysics nodes[];
};

layout(std430, binding = 1, set = 0) readonly buffer AdjacencyList {
	uint neighbors[];
};

layout(std430, binding = 2, set = 0) readonly buffer AdjOffsets {
	uint offsets[];
};

layout(std430, binding = 3, set = 0) readonly buffer AdjCounts {
	uint edge_counts[];
};

layout(push_constant) uniform SimParams {
	float dt;
	float alpha;
	float beta;
	float avg_degree;
	uint node_count;
} params;

void main() {
	uint id = gl_GlobalInvocationID.x;
	if (id >= params.node_count) return;

	float freedom = nodes[id].freedom.x;
	bool is_awake = (nodes[id].freedom.w > 0.5);

	const float SLEEP_THRESHOLD = 0.85;
	const float WAKE_THRESHOLD = 0.70;

	if (is_awake) {
		if (freedom > SLEEP_THRESHOLD && length(nodes[id].escape_vector.xyz) < 0.01) {
			is_awake = false;
		}
	} else {
		if (freedom < WAKE_THRESHOLD) {
			is_awake = true;
		}
	}

	nodes[id].freedom.w = is_awake ? 1.0 : 0.0;

	if (!is_awake) {
		return;
	}

	vec3 pos = nodes[id].position.xyz;
	vec3 escape_force = nodes[id].escape_vector.xyz;
	vec3 spring_force = vec3(0.0);

	uint start_idx = offsets[id];
	uint count = edge_counts[id];

	for (uint i = 0; i < count; i++) {
		uint neighbor_id = neighbors[start_idx + i];
		vec3 neighbor_pos = nodes[neighbor_id].position.xyz;

		vec3 diff = neighbor_pos - pos;
		float dist = length(diff);

		if (dist > 0.001) {
			// Linear attraction proportional to distance (no ideal length)
			spring_force += diff;
		}
	}

	// Scale spring force by degree: high-degree nodes feel weaker attraction per edge
	// (outbound attraction distribution, similar to ForceAtlas2)
	if (count > 0) {
		float degree_weight = (1.0 + params.avg_degree) / (1.0 + float(count));
		spring_force *= degree_weight;
	}

	// Scale escape force inversely by degree: low-degree nodes push outward more
	if (count > 0) {
		float degree_weight = (1.0 + params.avg_degree) / (1.0 + float(count));
		escape_force *= degree_weight;
	}

	vec3 total_force = (escape_force * params.alpha) + (spring_force * params.beta);

	// Direct displacement (overdamped, no velocity accumulator)
	nodes[id].position.xyz = pos + total_force * params.dt;
}
