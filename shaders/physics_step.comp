#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct NodePhysics {
	vec4 position;      // xyz=pos, w=nodeRadius
	vec4 escape_vector; // xyz=escape_dir, w=openness
	vec4 freedom;       // x=local_freedom [0..1], w=is_awake (1.0 awake, 0.0 asleep)
};

layout(std430, binding = 0, set = 0) buffer PhysicsBuffer {
	NodePhysics nodes[];
};

layout(std430, binding = 1, set = 0) readonly buffer AdjacencyList {
	uint neighbors[];
};

layout(std430, binding = 2, set = 0) readonly buffer AdjOffsets {
	uint offsets[];
};

layout(std430, binding = 3, set = 0) readonly buffer AdjCounts {
	uint edge_counts[];
};

layout(push_constant) uniform SimParams {
	float alpha;
	float avg_degree;
	uint node_count;
} params;

void main() {
	uint id = gl_GlobalInvocationID.x;
	if (id >= params.node_count) return;

	float freedom = nodes[id].freedom.x;
	bool is_awake = (nodes[id].freedom.w > 0.5);

	const float SLEEP_THRESHOLD = 0.95;
	const float WAKE_THRESHOLD = 0.70;

	if (is_awake) {
		if (freedom > SLEEP_THRESHOLD && length(nodes[id].escape_vector.xyz) < 0.01) {
			is_awake = false;
		}
	} else {
		if (freedom < WAKE_THRESHOLD) {
			is_awake = true;
		}
	}

	nodes[id].freedom.w = is_awake ? 1.0 : 0.0;

	if (!is_awake) {
		return;
	}

	vec3 pos = nodes[id].position.xyz;
	vec3 escape_force = nodes[id].escape_vector.xyz;

	uint start_idx = offsets[id];
	uint count = edge_counts[id];

	if (count > 0) {
		float degree_weight = (1.0 + params.avg_degree) / (1.0 + float(count));
		escape_force *= degree_weight;
	}

	nodes[id].position.xyz = pos + escape_force * params.alpha;
}
