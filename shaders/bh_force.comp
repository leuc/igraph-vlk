// =============================================================================
// BH Force Compute Shader — OWL Barnes-Hut Traversal via Ray Query
// =============================================================================
//
// Implements the exact OWL Barnes-Hut algorithm from deviceCode.cu, but
// using Vulkan ray queries (rayQueryEXT) in a compute shader instead of
// OptiX trace/invoke.
//
// Each workgroup processes one particle. The shader walks the octree by
// tracing rays through an AABB-based BLAS. The BVH spatially organizes
// octree nodes so that the hardware accelerates traversal.
//
// AABB hit (closest confirmed candidate) = BH criterion NOT met (approximate)
// Miss (no AABB in range)               = BH criterion met or end (descend)
//
// Binding layout:
//   binding 0: NodeBuffer    — vec4[xyz=pos, w=unused] per particle (readonly)
//   binding 1: ForceBuffer   — vec4[force.xyz, 0] per particle (writeonly)
//   binding 2: PointBuffer   — vec4[xyz=pos, w=mass] per particle (readonly)
//   binding 3: BhNodeBuffer  — BhNode[] octree device nodes (readonly)
//   binding 4: TLAS          — accelerationStructureEXT over AABB mesh
//
// Push constants (16 bytes):
//   uint   particle_count
//   uint   num_prims
//   float  threshold   (theta)
//   float  G           (gravitational constant)
// =============================================================================

#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// ---------------------------------------------------------------------------
// Device BH node — must match bh_device_node_t in C code
// ---------------------------------------------------------------------------
struct BhNode {
	float mass;
	float center_of_mass_x;
	float center_of_mass_y;
	float center_of_mass_z;
	float next_ray_location_x;
	float next_ray_location_y;
	int next_prim_id;
	float auto_rope_ray_location_x;
	float auto_rope_ray_location_y;
	int auto_rope_prim_id;
	int particles[32];
	int num_particles;
	uint is_leaf;
};

// ---------------------------------------------------------------------------
// Bindings
// ---------------------------------------------------------------------------
layout(std430, binding = 0) readonly buffer NodeBuffer {
	vec4 nodes[];
};

layout(std430, binding = 1) writeonly buffer ForceBuffer {
	vec4 forces[];
};

layout(std430, binding = 2) readonly buffer PointBuffer {
	vec4 points[];
};

layout(std430, binding = 3) readonly buffer BhNodeBuffer {
	BhNode bh_nodes[];
};

layout(binding = 4) uniform accelerationStructureEXT tlas;

// ---------------------------------------------------------------------------
// Push constants
// ---------------------------------------------------------------------------
layout(push_constant) uniform PC {
	uint particle_count;
	uint num_prims;
	float threshold;
	float G;
}
pc;

// ---------------------------------------------------------------------------
// Main: OWL Barnes-Hut traversal
// ---------------------------------------------------------------------------
void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= pc.particle_count)
		return;

	vec3 pos = points[i].xyz;
	float my_mass = points[i].w;
	vec3 accel_vec = vec3(0.0);

	int prim_id = 0;
	vec2 ray_origin = vec2(0.0);
	uint ray_self = 0u;

	while (prim_id >= 0 && uint(prim_id) < pc.num_prims) {
		vec3 com = vec3(
			bh_nodes[prim_id].center_of_mass_x,
			bh_nodes[prim_id].center_of_mass_y,
			bh_nodes[prim_id].center_of_mass_z
		);
		uint is_leaf = bh_nodes[prim_id].is_leaf;

		vec3 d = pos - com;
		float r2 = dot(d, d);
		float ray_length = sqrt(r2) * pc.threshold;

		rayQueryEXT rq;
		rayQueryInitializeEXT(rq, tlas,
		                      gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
		                      0xFF,
		                      vec3(ray_origin, 0.0),
		                      0.0,
		                      vec3(1.0, 0.0, 0.0),
		                      ray_length);

		while (rayQueryProceedEXT(rq)) {
			if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionAABBEXT) {
				rayQueryConfirmIntersectionEXT(rq);
				break;
			}
		}

		if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCandidateIntersectionAABBEXT) {
			// ======== CLOSEST HIT ========
			int hit_prim = int(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
			uint hit_is_leaf = bh_nodes[hit_prim].is_leaf;

			if (hit_is_leaf == 1u) {
				int num_p = bh_nodes[hit_prim].num_particles;
				for (int p = 0; p < num_p; p++) {
					int pid = bh_nodes[hit_prim].particles[p];
					if (pid != int(i)) {
						vec3 pd = pos - points[pid].xyz;
						float pr2 = dot(pd, pd);
						if (pr2 > 1e-24) {
							accel_vec += pd * (points[pid].w / pr2);
						}
					}
				}
			} else {
				vec3 h_com = vec3(
					bh_nodes[hit_prim].center_of_mass_x,
					bh_nodes[hit_prim].center_of_mass_y,
					bh_nodes[hit_prim].center_of_mass_z
				);
				vec3 hd = pos - h_com;
				float hr2 = dot(hd, hd);
				if (hr2 > 1e-24) {
					accel_vec += hd * (bh_nodes[hit_prim].mass / hr2);
				}
			}

			prim_id = bh_nodes[hit_prim].auto_rope_prim_id;
			ray_origin = vec2(bh_nodes[hit_prim].auto_rope_ray_location_x, bh_nodes[hit_prim].auto_rope_ray_location_y);
			ray_self = 0u;
		} else {
			// ======== MISS ========
			if (is_leaf == 1u && ray_self == 0u) {
				int num_p = bh_nodes[prim_id].num_particles;
				for (int p = 0; p < num_p; p++) {
					int pid = bh_nodes[prim_id].particles[p];
					if (pid != int(i)) {
						vec3 pd = pos - points[pid].xyz;
						float pr2 = dot(pd, pd);
						if (pr2 > 1e-24) {
							accel_vec += pd * (points[pid].w / pr2);
						}
					}
				}
			}

			prim_id = bh_nodes[prim_id].next_prim_id;
			ray_origin = vec2(bh_nodes[prim_id].next_ray_location_x, bh_nodes[prim_id].next_ray_location_y);
			ray_self = (ray_length == 0.0) ? 1u : 0u;
		}
	}

	forces[i] = vec4(accel_vec * (my_mass * pc.G), 0.0);
}
