#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#define STAGE_LNW 0u
#define STAGE_LNX 1u
#define STAGE_MATERIALIZE 2u
#define STAGE_HEIGHT 3u
#define STAGE_DEPTH 4u
#define STAGE_REDUCE 5u
#define STAGE_FLAGS 6u
#define STAGE_GLOBAL_TRACE 7u
#define STAGE_NPPC_ACCUMULATE_FWD 8u
#define STAGE_NPPC_ACCUMULATE_REV 9u

#define WEIGHT_SPLC 0u
#define WEIGHT_UNIT 1u
#define WEIGHT_SPC 2u
#define WEIGHT_SPE 3u
#define WEIGHT_NPPC 4u

#define RESULT_OVERFLOW (1u << 0u)
#define RESULT_INVALID (1u << 1u)
#define INVALID_NODE 0xffffffffu

struct CritNode
{
	uint edge_offset;
	uint degree;
};

struct CritEdge
{
	uint node;
	uint pad;
};

layout(std430, binding = 0) readonly buffer OutNodeBuffer
{
	CritNode out_nodes[];
};

layout(std430, binding = 1) readonly buffer OutEdgeBuffer
{
	CritEdge out_edges[];
};

layout(std430, binding = 2) readonly buffer InNodeBuffer
{
	CritNode in_nodes[];
};

layout(std430, binding = 3) readonly buffer InEdgeBuffer
{
	CritEdge in_edges[];
};

layout(std430, binding = 4) readonly buffer LevelBuffer
{
	uint level_nodes[];
};

layout(std430, binding = 5) buffer LnWBuffer
{
	float lnW[];
};

layout(std430, binding = 6) buffer LnXBuffer
{
	float lnX[];
};

layout(std430, binding = 7) buffer HeightBuffer
{
	float height[];
};

layout(std430, binding = 8) buffer DepthBuffer
{
	float depth[];
};

struct EdgeAnim
{
	float reveal_at;
	float strength;
};

layout(std430, binding = 9) buffer EdgeAnimation
{
	uint strength_max_bits;
	uint _pad0;
	uint _pad1;
	uint _pad2;
	EdgeAnim edges[];
}
edge_anim;

layout(std430, binding = 10) buffer ResultBuffer
{
	uint edge_count;
	uint node_count;
	uint status;
	uint criticality_max_bits;
	uint sink_height_bits;
	uint sink_node;
	uint _reserved0;
	uint _reserved1;
	uint data[];
}
result;

layout(std430, binding = 11) buffer ReachabilityBuffer
{
	// One word-tile's worth of columns of the ancestor/descendant bitset: node_count * tile_word_count
	// uints. Reused for both directions and overwritten every tile pass.
	uint reachability[];
};

layout(std430, binding = 12) buffer TotalCountFwdBuffer
{
	// Exact running ancestor popcount per node, accumulated across tile passes.
	uint total_count_fwd[];
};

layout(std430, binding = 13) buffer TotalCountRevBuffer
{
	// Exact running descendant popcount per node, accumulated across tile passes.
	uint total_count_rev[];
};

layout(push_constant) uniform Constants
{
	uint level_offset;
	uint num_nodes_in_level;
	uint stage;
	uint weight_mode;
	uint tile_word_offset;
	uint tile_word_count;
}
pc;

uint weight_offset()
{
	return 0u;
}

uint predecessor_offset()
{
	return result.edge_count;
}

uint basket_offset()
{
	return result.edge_count + result.node_count;
}

uint global_offset()
{
	return result.edge_count + 2u * result.node_count;
}

float softplus(float value)
{
	return value > 20.0 ? value : log(1.0 + exp(value));
}

bool criticality_equal(float a, float b)
{
	float scale = max(max(abs(a), abs(b)), 1.0);
	return abs(a - b) <= max(1e-4, 1e-5 * scale);
}

float finite_presentation(float value)
{
	if (isnan(value)) {
		atomicOr(result.status, RESULT_INVALID);
		return 0.0;
	}
	return isinf(value) ? uintBitsToFloat(0x7f7fffffu) : max(value, 0.0);
}

void write_presentation(uint edge_id, float strength)
{
	strength = finite_presentation(strength);
	edge_anim.edges[edge_id].strength = strength;
	atomicMax(edge_anim.strength_max_bits, floatBitsToUint(strength));
}

void record_forward_animation_edges(CritNode n, float log_count)
{
	float score = pc.weight_mode == WEIGHT_UNIT ? 1.0 : (pc.weight_mode == WEIGHT_SPE ? max(1.0 + log_count, 0.0) : softplus(log_count));
	for (uint i = 0u; i < n.degree; i++)
		write_presentation(out_edges[n.edge_offset + i].pad, score);
}

void record_projected_animation_edges(uint source, CritNode n)
{
	for (uint i = 0u; i < n.degree; i++) {
		CritEdge edge = out_edges[n.edge_offset + i];
		float log_weight = lnW[source] + lnX[edge.node];
		float score = pc.weight_mode == WEIGHT_SPE ? max(1.0 + log_weight, 0.0) : softplus(log_weight);
		write_presentation(edge.pad, score);
	}
}

void accumulate_reachability_tile(uint v, bool reverse)
{
	CritNode n = reverse ? out_nodes[v] : in_nodes[v];
	uint self_word = v / 32u;
	uint count = 0u;
	for (uint word = 0u; word < pc.tile_word_count; word++) {
		uint global_word = pc.tile_word_offset + word;
		uint value = global_word == self_word ? 1u << (v % 32u) : 0u;
		for (uint i = 0u; i < n.degree; i++) {
			uint adjacent = reverse ? out_edges[n.edge_offset + i].node : in_edges[n.edge_offset + i].node;
			value |= reachability[adjacent * pc.tile_word_count + word];
		}
		reachability[v * pc.tile_word_count + word] = value;
		count += bitCount(value);
	}
	// Exactly one invocation owns v per (tile, level) dispatch, and tile passes are
	// barrier/submission-serialized on the host, so this is race-free without an atomic.
	if (reverse)
		total_count_rev[v] += count;
	else
		total_count_fwd[v] += count;
}

void finalize_reachability(uint v, bool reverse)
{
	float log_count = log(float(reverse ? total_count_rev[v] : total_count_fwd[v]));
	if (reverse)
		lnX[v] = log_count;
	else {
		lnW[v] = log_count;
		record_forward_animation_edges(out_nodes[v], log_count);
	}
}

void materialize(uint v)
{
	CritNode n = out_nodes[v];
	for (uint i = 0u; i < n.degree; i++) {
		CritEdge edge = out_edges[n.edge_offset + i];
		float log_weight = pc.weight_mode == WEIGHT_SPLC ? lnW[v] : lnW[v] + lnX[edge.node];
		float analysis = pc.weight_mode == WEIGHT_UNIT ? 1.0 : (pc.weight_mode == WEIGHT_SPE ? log_weight : exp(log_weight));
		if (isnan(analysis))
			atomicOr(result.status, RESULT_INVALID);
		else if (isinf(analysis))
			atomicOr(result.status, RESULT_OVERFLOW);
		result.data[weight_offset() + edge.pad] = floatBitsToUint(analysis);
		float presentation = pc.weight_mode == WEIGHT_UNIT ? 1.0 : (pc.weight_mode == WEIGHT_SPE ? max(1.0 + log_weight, 0.0) : softplus(log_weight));
		write_presentation(edge.pad, presentation);
	}
}

void compute_height(uint v)
{
	if (result.status != 0u) {
		height[v] = 0.0;
		result.data[predecessor_offset() + v] = INVALID_NODE;
		return;
	}
	CritNode n = in_nodes[v];
	float best = 0.0;
	uint best_predecessor = INVALID_NODE;
	uint best_edge = INVALID_NODE;
	for (uint i = 0u; i < n.degree; i++) {
		CritEdge edge = in_edges[n.edge_offset + i];
		float weight = uintBitsToFloat(result.data[weight_offset() + edge.pad]);
		float candidate = height[edge.node] + weight;
		if (isnan(candidate)) {
			atomicOr(result.status, RESULT_INVALID);
			continue;
		}
		if (isinf(candidate)) {
			atomicOr(result.status, RESULT_OVERFLOW);
			continue;
		}
		if (candidate > best || (candidate == best && edge.pad < best_edge)) {
			best = candidate;
			best_predecessor = edge.node;
			best_edge = edge.pad;
		}
	}
	height[v] = best;
	result.data[predecessor_offset() + v] = best_predecessor;
}

void compute_depth(uint v)
{
	if (result.status != 0u) {
		depth[v] = 0.0;
		return;
	}
	CritNode n = out_nodes[v];
	float best = 0.0;
	for (uint i = 0u; i < n.degree; i++) {
		CritEdge edge = out_edges[n.edge_offset + i];
		float weight = uintBitsToFloat(result.data[weight_offset() + edge.pad]);
		float candidate = weight + depth[edge.node];
		if (isnan(candidate)) {
			atomicOr(result.status, RESULT_INVALID);
			continue;
		}
		if (isinf(candidate)) {
			atomicOr(result.status, RESULT_OVERFLOW);
			continue;
		}
		best = max(best, candidate);
	}
	depth[v] = best;
}

void reduce_node(uint v)
{
	if (result.status != 0u)
		return;
	atomicMax(result.criticality_max_bits, floatBitsToUint(height[v] + depth[v]));
	if (out_nodes[v].degree == 0u)
		atomicMax(result.sink_height_bits, floatBitsToUint(height[v]));
}

void write_flags(uint v)
{
	if (result.status != 0u)
		return;
	float maximum = uintBitsToFloat(result.criticality_max_bits);
	float sink_height = uintBitsToFloat(result.sink_height_bits);
	result.data[basket_offset() + v] = criticality_equal(maximum, height[v] + depth[v]) ? 1u : 0u;
	if (out_nodes[v].degree == 0u && abs(sink_height - height[v]) < 1e-4)
		atomicMin(result.sink_node, v);
}

void trace_global()
{
	if (result.status != 0u)
		return;
	uint v = result.sink_node;
	for (uint i = 0u; i < result.node_count; i++) {
		if (v == INVALID_NODE)
			return;
		if (v >= result.node_count) {
			atomicOr(result.status, RESULT_INVALID);
			return;
		}
		result.data[global_offset() + v] = 1u;
		v = result.data[predecessor_offset() + v];
	}
	if (v != INVALID_NODE)
		atomicOr(result.status, RESULT_INVALID);
}

void main()
{
	uint idx = gl_GlobalInvocationID.x;
	if (pc.stage == STAGE_GLOBAL_TRACE) {
		if (idx == 0u)
			trace_global();
		return;
	}
	if (idx >= pc.num_nodes_in_level)
		return;

	uint v = level_nodes[pc.level_offset + idx];
	if (pc.stage == STAGE_NPPC_ACCUMULATE_FWD) {
		accumulate_reachability_tile(v, false);
		return;
	}
	if (pc.stage == STAGE_NPPC_ACCUMULATE_REV) {
		accumulate_reachability_tile(v, true);
		return;
	}
	if (pc.stage == STAGE_LNW) {
		if (pc.weight_mode == WEIGHT_NPPC) {
			finalize_reachability(v, false);
			return;
		}
		CritNode n = in_nodes[v];
		float value = 0.0;
		if (pc.weight_mode == WEIGHT_SPLC) {
			float maximum = 0.0;
			for (uint i = 0u; i < n.degree; i++)
				maximum = max(maximum, lnW[in_edges[n.edge_offset + i].node]);
			float sum = exp(-maximum);
			for (uint i = 0u; i < n.degree; i++)
				sum += exp(lnW[in_edges[n.edge_offset + i].node] - maximum);
			value = maximum + log(sum);
		} else if (n.degree != 0u) {
			float maximum = -1.0 / 0.0;
			for (uint i = 0u; i < n.degree; i++)
				maximum = max(maximum, lnW[in_edges[n.edge_offset + i].node]);
			float sum = 0.0;
			for (uint i = 0u; i < n.degree; i++)
				sum += exp(lnW[in_edges[n.edge_offset + i].node] - maximum);
			value = maximum + log(sum);
		}
		lnW[v] = value;
		record_forward_animation_edges(out_nodes[v], value);
		return;
	}
	if (pc.stage == STAGE_LNX) {
		if (pc.weight_mode == WEIGHT_NPPC) {
			finalize_reachability(v, true);
			record_projected_animation_edges(v, out_nodes[v]);
			return;
		}
		CritNode n = out_nodes[v];
		float value = 0.0;
		if (n.degree != 0u) {
			float maximum = -1.0 / 0.0;
			for (uint i = 0u; i < n.degree; i++)
				maximum = max(maximum, lnX[out_edges[n.edge_offset + i].node]);
			float sum = 0.0;
			for (uint i = 0u; i < n.degree; i++)
				sum += exp(lnX[out_edges[n.edge_offset + i].node] - maximum);
			value = maximum + log(sum);
		}
		lnX[v] = value;
		if (pc.weight_mode == WEIGHT_SPC || pc.weight_mode == WEIGHT_SPE)
			record_projected_animation_edges(v, n);
		return;
	}
	if (pc.stage == STAGE_MATERIALIZE) {
		materialize(v);
		return;
	}
	if (pc.stage == STAGE_HEIGHT) {
		compute_height(v);
		return;
	}
	if (pc.stage == STAGE_DEPTH) {
		compute_depth(v);
		return;
	}
	if (pc.stage == STAGE_REDUCE) {
		reduce_node(v);
		return;
	}
	write_flags(v);
}
