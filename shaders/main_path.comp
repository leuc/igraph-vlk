#version 450

// Price & Evans (2025) — Understanding Main Path Analysis
// arXiv:2512.12355 [physics.soc-ph], section 2.5 "Baskets of Nodes"
// https://doi.org/10.48550/arXiv.2512.12355
//
// The shared Main Path compute shader. Four level-synchronous dynamic
// programming sweeps over a DAG:
//
//   stage 0  lnW(v) = ln(number of paths source -> v)     eq. 2.8b
//   stage 1  lnX(v) = ln(number of paths v -> sink)       eq. 2.8c
//   stage 2  h(v)   = max weight of any path source -> v  eq. 2.12
//   stage 3  d(v)   = max weight of any path v -> sink    eq. 2.13
//
// The host assigns levels by longest-path relaxation, so every edge (u, v)
// has level(v) > level(u). Dispatching levels in ascending order for stages
// 0 and 2, and descending order for stages 1 and 3, therefore guarantees
// every value read has already been finalised: all four sweeps are pure
// gathers and need no atomics at all.
//
// Path counts grow factorially with graph size (section 2.6), so they are
// carried as natural logarithms and combined with a shifted log-sum-exp.
// The entropy (SPE) edge weight is then just lnW(u) + lnX(v), eq. 2.8a.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#define STAGE_LNW 0u
#define STAGE_LNX 1u
#define STAGE_HEIGHT 2u
#define STAGE_DEPTH 3u

#define WEIGHT_SPLC 0u
#define WEIGHT_UNIT 1u
#define WEIGHT_SPC 2u
#define WEIGHT_SPE 3u

struct CritNode
{
	uint edge_offset;
	uint degree;
};

struct CritEdge
{
	uint node;
	uint pad;
};

// Forward (out-edge) CSR: successors of v
layout(std430, binding = 0) readonly buffer OutNodeBuffer
{
	CritNode out_nodes[];
};

layout(std430, binding = 1) readonly buffer OutEdgeBuffer
{
	CritEdge out_edges[];
};

// Reverse (in-edge) CSR: predecessors of v
layout(std430, binding = 2) readonly buffer InNodeBuffer
{
	CritNode in_nodes[];
};

layout(std430, binding = 3) readonly buffer InEdgeBuffer
{
	CritEdge in_edges[];
};

// All node ids, grouped by level; one contiguous run per level
layout(std430, binding = 4) readonly buffer LevelBuffer
{
	uint level_nodes[];
};

layout(std430, binding = 5) buffer LnWBuffer
{
	float lnW[];
};

layout(std430, binding = 6) buffer LnXBuffer
{
	float lnX[];
};

layout(std430, binding = 7) buffer HeightBuffer
{
	float height[];
};

layout(std430, binding = 8) buffer DepthBuffer
{
	float depth[];
};

struct DisplayEdge
{
	uint target_node;
	float weight;
};

layout(std430, binding = 9) buffer DisplayEdgeBuffer
{
	DisplayEdge display_edges[];
};

layout(std430, binding = 10) buffer DisplayMaxBuffer
{
	uint display_max_weight_uint;
};

layout(std430, binding = 11) readonly buffer EdgeWeightBuffer
{
	float edge_weights[];
};

layout(push_constant) uniform Constants
{
	uint level_offset;
	uint num_nodes_in_level;
	uint stage;
	uint weight_mode;
}
pc;

float softplus(float value)
{
	return value > 20.0 ? value : log(1.0 + exp(value));
}

void record_display_edges(CritNode n, float score)
{
	uint encoded_score = floatBitsToUint(score);
	for (uint i = 0u; i < n.degree; i++) {
		uint edge_id = out_edges[n.edge_offset + i].pad;
		display_edges[edge_id].weight = score;
		atomicMax(display_max_weight_uint, encoded_score);
	}
}

void record_projected_display_edges(uint source, CritNode n)
{
	for (uint i = 0u; i < n.degree; i++) {
		CritEdge edge = out_edges[n.edge_offset + i];
		float log_count = lnW[source] + lnX[edge.node];
		float score = pc.weight_mode == WEIGHT_SPE ? 1.0 + log_count : softplus(log_count);
		display_edges[edge.pad].weight = score;
		atomicMax(display_max_weight_uint, floatBitsToUint(score));
	}
}

void record_forward_display_edges(CritNode n, float log_count)
{
	float score = pc.weight_mode == WEIGHT_UNIT ? 1.0 : (pc.weight_mode == WEIGHT_SPE ? 1.0 + log_count : softplus(log_count));
	record_display_edges(n, score);
}

float selection_weight(CritEdge edge)
{
	return edge_weights[edge.pad];
}

void main()
{
	uint idx = gl_GlobalInvocationID.x;
	if (idx >= pc.num_nodes_in_level)
		return;

	uint v = level_nodes[pc.level_offset + idx];

	if (pc.stage == STAGE_LNW) {
		// SPLC counts every path ending at v, including the length-zero path.
		// Therefore W(v) = 1 + sum(pred W), unlike SPC's source-rooted count.
		// Unit/SPC/SPE retain the source-rooted convention of Price & Evans.
		CritNode n = in_nodes[v];
		float value = 0.0;
		if (pc.weight_mode == WEIGHT_SPLC) {
			float m = 0.0;
			for (uint i = 0u; i < n.degree; i++)
				m = max(m, lnW[in_edges[n.edge_offset + i].node]);
			float sum = exp(-m);
			for (uint i = 0u; i < n.degree; i++)
				sum += exp(lnW[in_edges[n.edge_offset + i].node] - m);
			value = m + log(sum);
		} else if (n.degree != 0u) {
			float m = -1.0 / 0.0;
			for (uint i = 0u; i < n.degree; i++)
				m = max(m, lnW[in_edges[n.edge_offset + i].node]);
			float sum = 0.0;
			for (uint i = 0u; i < n.degree; i++)
				sum += exp(lnW[in_edges[n.edge_offset + i].node] - m);
			value = m + log(sum);
		}
		lnW[v] = value;
		// Every method exposes this forward prefix sweep. SPC/SPE then refine
		// the same edges in reverse with their suffix count in STAGE_LNX.
		record_forward_display_edges(out_nodes[v], value);
		return;
	}

	if (pc.stage == STAGE_LNX) {
		CritNode n = out_nodes[v];
		float value = 0.0;
		if (n.degree != 0u) {
			float m = -1.0 / 0.0;
			for (uint i = 0u; i < n.degree; i++)
				m = max(m, lnX[out_edges[n.edge_offset + i].node]);
			float sum = 0.0;
			for (uint i = 0u; i < n.degree; i++)
				sum += exp(lnX[out_edges[n.edge_offset + i].node] - m);
			value = m + log(sum);
		}
		lnX[v] = value;
		if (pc.weight_mode == WEIGHT_SPC || pc.weight_mode == WEIGHT_SPE)
			record_projected_display_edges(v, n);
		return;
	}

	if (pc.stage == STAGE_HEIGHT) {
		CritNode n = in_nodes[v];
		float best = 0.0;
		for (uint i = 0u; i < n.degree; i++) {
			CritEdge edge = in_edges[n.edge_offset + i];
			uint u = edge.node;
			float w = selection_weight(edge);
			best = max(best, height[u] + w);
		}
		height[v] = best;
		return;
	}

	// STAGE_DEPTH
	CritNode n = out_nodes[v];
	float best = 0.0;
	for (uint i = 0u; i < n.degree; i++) {
		CritEdge edge = out_edges[n.edge_offset + i];
		uint s = edge.node;
		float w = selection_weight(edge);
		best = max(best, depth[s] + w);
	}
	depth[v] = best;
}
