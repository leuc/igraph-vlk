#version 450

#ifdef CRIT_FP64
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
#define Value double
#define VALUE_WORD_COUNT 2u
#else
#define Value float
#define VALUE_WORD_COUNT 1u
#endif

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#define STAGE_LNW 0u
#define STAGE_LNX 1u
#define STAGE_MATERIALIZE 2u
#define STAGE_HEIGHT 3u
#define STAGE_DEPTH 4u
#define STAGE_REDUCE 5u
#define STAGE_FLAGS 6u
#define STAGE_PATH_TRACE 7u

#define WEIGHT_SPLC 0u
#define WEIGHT_UNIT 1u
#define WEIGHT_SPC 2u
#define WEIGHT_SPE 3u

#define RESULT_OVERFLOW (1u << 0u)
#define RESULT_INVALID (1u << 1u)
#define INVALID_NODE 0xffffffffu

struct CritNode
{
	uint edge_offset;
	uint degree;
};

struct CritEdge
{
	uint node;
	uint pad;
};

layout(std430, binding = 0) readonly buffer OutNodeBuffer
{
	CritNode out_nodes[];
};

layout(std430, binding = 1) readonly buffer OutEdgeBuffer
{
	CritEdge out_edges[];
};

layout(std430, binding = 2) readonly buffer InNodeBuffer
{
	CritNode in_nodes[];
};

layout(std430, binding = 3) readonly buffer InEdgeBuffer
{
	CritEdge in_edges[];
};

layout(std430, binding = 4) readonly buffer LevelBuffer
{
	uint level_nodes[];
};

layout(std430, binding = 5) buffer LnWBuffer
{
	Value lnW[];
};

layout(std430, binding = 6) buffer LnXBuffer
{
	Value lnX[];
};

layout(std430, binding = 7) buffer HeightBuffer
{
	Value height[];
};

layout(std430, binding = 8) buffer DepthBuffer
{
	Value depth[];
};

struct EdgeAnim
{
	float reveal_at;
	float strength;
};

layout(std430, binding = 9) buffer EdgeAnimation
{
	uint strength_max_bits;
	uint _pad0;
	uint _pad1;
	uint _pad2;
	EdgeAnim edges[];
}
edge_anim;

layout(std430, binding = 10) buffer ResultBuffer
{
	uint edge_count;
	uint node_count;
	uint status;
	uint value_word_count;
#ifdef CRIT_FP64
	uint64_t criticality_max_bits;
	uint64_t sink_height_bits;
#else
	uvec2 criticality_max_bits;
	uvec2 sink_height_bits;
#endif
	uint sink_node;
	uint _reserved;
	uint data[];
}
result;

layout(push_constant) uniform Constants
{
	uint level_offset;
	uint num_nodes_in_level;
	uint stage;
	uint weight_mode;
}
pc;

uint weight_offset()
{
	return 0u;
}

uint predecessor_offset()
{
	return result.edge_count * result.value_word_count;
}

uint basket_offset()
{
	return predecessor_offset() + result.node_count;
}

uint path_offset()
{
	return basket_offset() + result.node_count;
}

Value value_exp(Value value)
{
#ifdef CRIT_FP64
	if (value > 709.782712893384)
		return 1.0 / 0.0;
	if (value < -708.396418532264)
		return 0.0;
	int exponent = int(floor(value * 1.4426950408889634));
	Value remainder = value - Value(exponent) * 0.6931471805599453;
	Value term = 1.0;
	Value sum = 1.0;
	for (int i = 1; i <= 18; i++) {
		term *= remainder / Value(i);
		sum += term;
	}
	uint64_t exponent_bits = uint64_t(exponent + 1023) << 52u;
	Value scale = packDouble2x32(uvec2(uint(exponent_bits), uint(exponent_bits >> 32u)));
	return sum * scale;
#else
	return exp(value);
#endif
}

Value value_log(Value value)
{
#ifdef CRIT_FP64
	uvec2 bits = unpackDouble2x32(value);
	uint exponent_bits = (bits.y >> 20u) & 0x7ffu;
	bits.y = (bits.y & 0x000fffffu) | 0x3ff00000u;
	Value mantissa = packDouble2x32(bits);
	Value z = (mantissa - 1.0) / (mantissa + 1.0);
	Value z_squared = z * z;
	Value term = z;
	Value sum = z;
	for (int denominator = 3; denominator <= 49; denominator += 2) {
		term *= z_squared;
		sum += term / Value(denominator);
	}
	return 2.0 * sum + Value(int(exponent_bits) - 1023) * 0.6931471805599453;
#else
	return log(value);
#endif
}

Value softplus(Value value)
{
	return value > 20.0 ? value : value_log(1.0 + value_exp(value));
}

void store_weight(uint edge_id, Value value)
{
#ifdef CRIT_FP64
	uvec2 bits = unpackDouble2x32(value);
	result.data[weight_offset() + 2u * edge_id] = bits.x;
	result.data[weight_offset() + 2u * edge_id + 1u] = bits.y;
#else
	result.data[weight_offset() + edge_id] = floatBitsToUint(value);
#endif
}

Value load_weight(uint edge_id)
{
#ifdef CRIT_FP64
	uint offset = weight_offset() + 2u * edge_id;
	return packDouble2x32(uvec2(result.data[offset], result.data[offset + 1u]));
#else
	return uintBitsToFloat(result.data[weight_offset() + edge_id]);
#endif
}

Value criticality_maximum()
{
#ifdef CRIT_FP64
	return packDouble2x32(uvec2(uint(result.criticality_max_bits), uint(result.criticality_max_bits >> 32u)));
#else
	return uintBitsToFloat(result.criticality_max_bits.x);
#endif
}

Value sink_height_maximum()
{
#ifdef CRIT_FP64
	return packDouble2x32(uvec2(uint(result.sink_height_bits), uint(result.sink_height_bits >> 32u)));
#else
	return uintBitsToFloat(result.sink_height_bits.x);
#endif
}

void reduce_criticality_max(Value value)
{
#ifdef CRIT_FP64
	uvec2 bits = unpackDouble2x32(value);
	atomicMax(result.criticality_max_bits, uint64_t(bits.x) | (uint64_t(bits.y) << 32u));
#else
	atomicMax(result.criticality_max_bits.x, floatBitsToUint(value));
#endif
}

void reduce_sink_height(Value value)
{
#ifdef CRIT_FP64
	uvec2 bits = unpackDouble2x32(value);
	atomicMax(result.sink_height_bits, uint64_t(bits.x) | (uint64_t(bits.y) << 32u));
#else
	atomicMax(result.sink_height_bits.x, floatBitsToUint(value));
#endif
}

bool criticality_equal(Value a, Value b)
{
	Value scale = max(max(abs(a), abs(b)), 1.0);
#ifdef CRIT_FP64
	return abs(a - b) <= max(1e-9, 1e-12 * scale);
#else
	return abs(a - b) <= max(1e-4, 1e-5 * scale);
#endif
}

float finite_presentation(float value)
{
	if (isnan(value)) {
		atomicOr(result.status, RESULT_INVALID);
		return 0.0;
	}
	return isinf(value) ? uintBitsToFloat(0x7f7fffffu) : max(value, 0.0);
}

void write_presentation(uint edge_id, float strength)
{
	strength = finite_presentation(strength);
	edge_anim.edges[edge_id].strength = strength;
	atomicMax(edge_anim.strength_max_bits, floatBitsToUint(strength));
}

void record_forward_animation_edges(CritNode n, Value log_count)
{
	float score = float(pc.weight_mode == WEIGHT_UNIT ? 1.0 : (pc.weight_mode == WEIGHT_SPE ? max(1.0 + log_count, 0.0) : softplus(log_count)));
	for (uint i = 0u; i < n.degree; i++)
		write_presentation(out_edges[n.edge_offset + i].pad, score);
}

void record_projected_animation_edges(uint source, CritNode n)
{
	for (uint i = 0u; i < n.degree; i++) {
		CritEdge edge = out_edges[n.edge_offset + i];
		Value log_weight = lnW[source] + lnX[edge.node];
		float score = float(pc.weight_mode == WEIGHT_SPE ? max(1.0 + log_weight, 0.0) : softplus(log_weight));
		write_presentation(edge.pad, score);
	}
}

void materialize(uint v)
{
	CritNode n = out_nodes[v];
	for (uint i = 0u; i < n.degree; i++) {
		CritEdge edge = out_edges[n.edge_offset + i];
		Value log_weight = pc.weight_mode == WEIGHT_SPLC ? lnW[v] : lnW[v] + lnX[edge.node];
		Value analysis = pc.weight_mode == WEIGHT_UNIT ? 1.0 : (pc.weight_mode == WEIGHT_SPE ? log_weight : value_exp(log_weight));
		if (isnan(analysis))
			atomicOr(result.status, RESULT_INVALID);
		else if (isinf(analysis))
			atomicOr(result.status, RESULT_OVERFLOW);
		store_weight(edge.pad, analysis);
		float presentation = float(pc.weight_mode == WEIGHT_UNIT ? 1.0 : (pc.weight_mode == WEIGHT_SPE ? max(1.0 + log_weight, 0.0) : softplus(log_weight)));
		write_presentation(edge.pad, presentation);
	}
}

void compute_height(uint v)
{
	if (result.status != 0u) {
		height[v] = 0.0;
		result.data[predecessor_offset() + v] = INVALID_NODE;
		return;
	}
	CritNode n = in_nodes[v];
	Value best = 0.0;
	uint best_predecessor = INVALID_NODE;
	uint best_edge = INVALID_NODE;
	for (uint i = 0u; i < n.degree; i++) {
		CritEdge edge = in_edges[n.edge_offset + i];
		Value weight = load_weight(edge.pad);
		Value candidate = height[edge.node] + weight;
		if (isnan(candidate)) {
			atomicOr(result.status, RESULT_INVALID);
			continue;
		}
		if (isinf(candidate)) {
			atomicOr(result.status, RESULT_OVERFLOW);
			continue;
		}
		if (candidate > best || (candidate == best && edge.pad < best_edge)) {
			best = candidate;
			best_predecessor = edge.node;
			best_edge = edge.pad;
		}
	}
	height[v] = best;
	result.data[predecessor_offset() + v] = best_predecessor;
}

void compute_depth(uint v)
{
	if (result.status != 0u) {
		depth[v] = 0.0;
		return;
	}
	CritNode n = out_nodes[v];
	Value best = 0.0;
	for (uint i = 0u; i < n.degree; i++) {
		CritEdge edge = out_edges[n.edge_offset + i];
		Value weight = load_weight(edge.pad);
		Value candidate = weight + depth[edge.node];
		if (isnan(candidate)) {
			atomicOr(result.status, RESULT_INVALID);
			continue;
		}
		if (isinf(candidate)) {
			atomicOr(result.status, RESULT_OVERFLOW);
			continue;
		}
		best = max(best, candidate);
	}
	depth[v] = best;
}

void reduce_node(uint v)
{
	if (result.status != 0u)
		return;
	reduce_criticality_max(height[v] + depth[v]);
	if (out_nodes[v].degree == 0u)
		reduce_sink_height(height[v]);
}

void write_flags(uint v)
{
	if (result.status != 0u)
		return;
	Value maximum = criticality_maximum();
	Value sink_height = sink_height_maximum();
	result.data[basket_offset() + v] = criticality_equal(maximum, height[v] + depth[v]) ? 1u : 0u;
	if (out_nodes[v].degree == 0u && criticality_equal(sink_height, height[v]))
		atomicMin(result.sink_node, v);
}

void trace_path()
{
	if (result.status != 0u)
		return;
	uint v = result.sink_node;
	for (uint i = 0u; i < result.node_count; i++) {
		if (v == INVALID_NODE)
			return;
		if (v >= result.node_count) {
			atomicOr(result.status, RESULT_INVALID);
			return;
		}
		result.data[path_offset() + v] = 1u;
		v = result.data[predecessor_offset() + v];
	}
	if (v != INVALID_NODE)
		atomicOr(result.status, RESULT_INVALID);
}

void main()
{
	uint idx = gl_GlobalInvocationID.x;
	if (pc.stage == STAGE_PATH_TRACE) {
		if (idx == 0u)
			trace_path();
		return;
	}
	if (idx >= pc.num_nodes_in_level)
		return;

	uint v = level_nodes[pc.level_offset + idx];
	if (pc.stage == STAGE_LNW) {
		CritNode n = in_nodes[v];
		Value value = 0.0;
		if (pc.weight_mode == WEIGHT_SPLC) {
			Value maximum = 0.0;
			for (uint i = 0u; i < n.degree; i++)
				maximum = max(maximum, lnW[in_edges[n.edge_offset + i].node]);
			Value sum = value_exp(-maximum);
			for (uint i = 0u; i < n.degree; i++)
				sum += value_exp(lnW[in_edges[n.edge_offset + i].node] - maximum);
			value = maximum + value_log(sum);
		} else if (n.degree != 0u) {
			Value maximum = -1.0 / 0.0;
			for (uint i = 0u; i < n.degree; i++)
				maximum = max(maximum, lnW[in_edges[n.edge_offset + i].node]);
			Value sum = 0.0;
			for (uint i = 0u; i < n.degree; i++)
				sum += value_exp(lnW[in_edges[n.edge_offset + i].node] - maximum);
			value = maximum + value_log(sum);
		}
		lnW[v] = value;
		record_forward_animation_edges(out_nodes[v], value);
		return;
	}
	if (pc.stage == STAGE_LNX) {
		CritNode n = out_nodes[v];
		Value value = 0.0;
		if (n.degree != 0u) {
			Value maximum = -1.0 / 0.0;
			for (uint i = 0u; i < n.degree; i++)
				maximum = max(maximum, lnX[out_edges[n.edge_offset + i].node]);
			Value sum = 0.0;
			for (uint i = 0u; i < n.degree; i++)
				sum += value_exp(lnX[out_edges[n.edge_offset + i].node] - maximum);
			value = maximum + value_log(sum);
		}
		lnX[v] = value;
		if (pc.weight_mode == WEIGHT_SPC || pc.weight_mode == WEIGHT_SPE)
			record_projected_animation_edges(v, n);
		return;
	}
	if (pc.stage == STAGE_MATERIALIZE) {
		materialize(v);
		return;
	}
	if (pc.stage == STAGE_HEIGHT) {
		compute_height(v);
		return;
	}
	if (pc.stage == STAGE_DEPTH) {
		compute_depth(v);
		return;
	}
	if (pc.stage == STAGE_REDUCE) {
		reduce_node(v);
		return;
	}
	write_flags(v);
}
